  "acceptance_criteria": [
    {"id": "AC-001", "description": "Order amount > 1000 RUB gets 5% discount", "priority": "must"},
    {"id": "AC-002", "description": "Order amount > 5000 RUB gets 10% discount", "priority": "must"},
    {"id": "AC-003", "description": "Order exactly 1000 or 5000 gets previous tier discount", "priority": "must"},
