    {"id": "AC-005", "description": "Percentage promo code adds to total discount", "priority": "must"},
    {"id": "AC-006", "description": "Only one promo code per order", "priority": "must"},
    {"id": "AC-007", "description": "VIP status adds +5% to total discount", "priority": "must"},
    {"id": "AC-008", "description": "All discounts calculated from original amount and summed", "priority": "must"},
    {"id": "AC-009", "description": "Maximum total discount is 30%", "priority": "must"},
    {"id": "AC-010", "description": "Use Decimal for all calculations", "priority": "must"},
    {"id": "AC-011", "description": "Round final amount to 2 decimal places", "priority": "must"},
    {"id": "AC-012", "description": "Negative amount raises ValueError", "priority": "must"},
